#pragma kernel GenerateVoxelData

RWStructuredBuffer<uint> ResultBuffer;
float3 ChunkOffset;
int ChunkSize;

float3 mod289(float3 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 mod289(float4 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 permute(float4 x)
{
    return mod289(((x * 34.0) + 1.0) * x);
}

float4 taylorInvSqrt(float4 r)
{
    return rsqrt(r);
}

float snoise(float3 v)
{
    const float2 C = float2(1.0 / 6.0, 1.0 / 3.0);
    const float4 D = float4(0.0, 0.5, 1.0, 2.0);

    float3 i = floor(v + dot(v, C.yyy));
    float3 x0 = v - i + dot(i, C.xxx);

    float3 g = step(x0.yzx, x0.xyz);
    float3 l = 1.0 - g;
    float3 i1 = min(g.xyz, l.zxy);
    float3 i2 = max(g.xyz, l.zxy);

    float3 x1 = x0 - i1 + C.xxx;
    float3 x2 = x0 - i2 + C.yyy;
    float3 x3 = x0 - D.yyy;

    i = mod289(i);
    float4 p = permute(permute(permute(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));

    float n_ = 1.0 / 7.0;
    float3 ns = n_ * D.wyz - D.xzx;
    float4 j = p - 49.0 * floor(p * ns.z * ns.z);

    float4 x_ = floor(j * ns.z);
    float4 y_ = floor(j - 7.0 * x_);

    float4 x = x_ * ns.x + ns.yyyy;
    float4 y = y_ * ns.x + ns.yyyy;
    float4 h = 1.0 - abs(x) - abs(y);

    float4 b0 = float4(x.xy, y.xy);
    float4 b1 = float4(x.zw, y.zw);

    float4 s0 = floor(b0) * 2.0 + 1.0;
    float4 s1 = floor(b1) * 2.0 + 1.0;
    float4 sh = -step(h, float4(0.0, 0.0, 0.0, 0.0));

    float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

    float3 p0 = float3(a0.xy, h.x);
    float3 p1 = float3(a0.zw, h.y);
    float3 p2 = float3(a1.xy, h.z);
    float3 p3 = float3(a1.zw, h.w);

    float4 norm = taylorInvSqrt(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;

    float4 m = max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

float2 GetDensity(float3 globalPos)
{
    float baseHeight = 60.0;
    float terrainNoise = snoise(float3(globalPos.xz * 0.005, 0.0)) * 30.0;
    float surfaceHeight = baseHeight + terrainNoise;

    float finalDensity = -1.0;
    float islandDensity = -100.0;
    
    if (globalPos.y <= surfaceHeight)
    {
        finalDensity = 1.0; 

        float3 cavePos = globalPos * 0.015;
        
        float n1 = snoise(cavePos);
        float n2 = snoise(cavePos + float3(15.3, 75.1, 31.9));
        float spaghetti = (n1 * n1) + (n2 * n2);
        
        float cheese = snoise(globalPos * 0.012);

        float entryNoise = snoise(float3(globalPos.xz * 0.02, 0.0));
        
        float depthMask = smoothstep(surfaceHeight + 2.0, surfaceHeight - 10.0, globalPos.y);

        float entranceThreshold = 0.03 + (max(0, entryNoise) * 0.1);
        
        bool isSpaghetti = spaghetti < entranceThreshold;
        bool isCheese = cheese > (0.65 - max(0, entryNoise) * 0.1);

        if (isSpaghetti || (isCheese && depthMask > 0.5))
        {
            finalDensity = -1.0;
        }
    }
    else
    {
        float skyNoise = snoise(globalPos * 0.04);
        float skyMask = smoothstep(surfaceHeight + 25.0, surfaceHeight + 60.0, globalPos.y);
        
        if (skyNoise > 0.6)
        {
            islandDensity = (skyNoise - 0.6) * skyMask * 10.0;
            finalDensity = islandDensity;
        }
    }

    return float2(finalDensity, islandDensity);
}

[numthreads(8, 8, 8)]
void GenerateVoxelData(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) ChunkSize || id.y >= (uint) ChunkSize || id.z >= (uint) ChunkSize) 
        return;

    float3 globalPos = ChunkOffset + float3(id);

    float2 densities = GetDensity(globalPos);
    float currentGround = densities.x;
    float currentIsland = densities.y;
    float currentFinal = max(currentGround, currentIsland);

    int blockType = 0;

    if (currentFinal > 0)
    {
        float2 densitiesAbove = GetDensity(globalPos + float3(0, 1, 0));
        float aboveFinal = max(densitiesAbove.x, densitiesAbove.y);

        if (currentIsland > currentGround)
        {
            blockType = 4; 
        }
        else
        {
            if (aboveFinal <= 0) // Air
            {
                blockType = 1; // Grass
            }
            else 
            {
                if (currentGround > 10.0)
                    blockType = 3; // Stone
                else
                    blockType = 2; // Dirt
            }
        }
    }

    int index = id.x + (id.y * ChunkSize) + (id.z * ChunkSize * ChunkSize);
    uint uintIndex = (uint) index / 4;
    uint byteOffset = (uint) index % 4;
    uint packedValue = (uint) blockType << (byteOffset * 8);
    InterlockedOr(ResultBuffer[uintIndex], packedValue);
}